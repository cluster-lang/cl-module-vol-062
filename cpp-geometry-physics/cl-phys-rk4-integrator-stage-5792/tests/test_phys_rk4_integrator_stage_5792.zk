import "../prk_5792.zk"

fn test_run():
    res := rk4_step_5792(10.0, 3.0, 3.0, 1.0)
    diff := res - 70.9200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
