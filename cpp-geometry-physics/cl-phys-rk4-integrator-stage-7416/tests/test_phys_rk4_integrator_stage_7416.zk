// cl-phys-rk4-integrator-stage-7416: Test Suite
import "../prk_7416.zk"

fn test_run():
    res := rk4_step_7416(10.0, 3.0, 3.0, 1.0)
    diff := res - 87.1600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-7416!")
