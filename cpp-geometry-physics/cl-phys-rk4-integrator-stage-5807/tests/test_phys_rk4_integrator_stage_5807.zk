// cl-phys-rk4-integrator-stage-5807: Test Suite
import "../prk_5807.zk"

fn test_run():
    res := rk4_step_5807(10.0, 3.0, 3.0, 1.0)
    diff := res - 71.0700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
