// cl-phys-rk4-integrator-stage-3845: Test Suite
import "../prk_3845.zk"

fn test_run():
    res := rk4_step_3845(10.0, 3.0, 3.0, 1.0)
    diff := res - 51.4500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-3845!")
