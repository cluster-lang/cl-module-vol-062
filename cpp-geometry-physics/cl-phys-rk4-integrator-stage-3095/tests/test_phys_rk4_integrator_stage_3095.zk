// cl-phys-rk4-integrator-stage-3095: Test Suite
import "../prk_3095.zk"

fn test_run():
    res := rk4_step_3095(10.0, 3.0, 3.0, 1.0)
    diff := res - 43.9500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
