// cl-phys-rk4-integrator-stage-5549: Test Suite
import "../prk_5549.zk"

fn test_run():
    res := rk4_step_5549(10.0, 3.0, 3.0, 1.0)
    diff := res - 68.4900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
