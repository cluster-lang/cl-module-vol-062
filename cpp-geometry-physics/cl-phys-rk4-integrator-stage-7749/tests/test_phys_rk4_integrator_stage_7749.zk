// cl-phys-rk4-integrator-stage-7749: Test Suite
import "../prk_7749.zk"

fn test_run():
    res := rk4_step_7749(10.0, 3.0, 3.0, 1.0)
    diff := res - 90.4900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
