// cl-phys-rk4-integrator-stage-7271: Test Suite
import "../prk_7271.zk"

fn test_run():
    res := rk4_step_7271(10.0, 3.0, 3.0, 1.0)
    diff := res - 85.7100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
