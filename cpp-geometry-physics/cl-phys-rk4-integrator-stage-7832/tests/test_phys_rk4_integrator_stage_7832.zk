// cl-phys-rk4-integrator-stage-7832: Test Suite
import "../prk_7832.zk"

fn test_run():
    res := rk4_step_7832(10.0, 3.0, 3.0, 1.0)
    diff := res - 91.3200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
