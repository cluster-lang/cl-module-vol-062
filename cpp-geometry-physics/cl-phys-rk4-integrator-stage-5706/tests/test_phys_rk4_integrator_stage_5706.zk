// cl-phys-rk4-integrator-stage-5706: Test Suite
import "../prk_5706.zk"

fn test_run():
    res := rk4_step_5706(10.0, 3.0, 3.0, 1.0)
    diff := res - 70.0600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
