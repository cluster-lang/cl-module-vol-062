// cl-phys-rk4-integrator-stage-7111: Test Suite
import "../prk_7111.zk"

fn test_run():
    res := rk4_step_7111(10.0, 3.0, 3.0, 1.0)
    diff := res - 84.1100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
