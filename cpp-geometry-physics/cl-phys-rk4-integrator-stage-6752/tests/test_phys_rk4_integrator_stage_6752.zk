import "../prk_6752.zk"

fn test_run():
    res := rk4_step_6752(10.0, 3.0, 3.0, 1.0)
    diff := res - 80.5200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
