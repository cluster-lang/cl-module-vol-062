// cl-phys-rk4-integrator-stage-3951: Test Suite
import "../prk_3951.zk"

fn test_run():
    res := rk4_step_3951(10.0, 3.0, 3.0, 1.0)
    diff := res - 52.5100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
