// cl-phys-rk4-integrator-stage-4310: Test Suite
import "../prk_4310.zk"

fn test_run():
    res := rk4_step_4310(10.0, 3.0, 3.0, 1.0)
    diff := res - 56.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-4310!")
