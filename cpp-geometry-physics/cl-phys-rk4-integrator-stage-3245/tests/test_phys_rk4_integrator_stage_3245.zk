// cl-phys-rk4-integrator-stage-3245: Test Suite
import "../prk_3245.zk"

fn test_run():
    res := rk4_step_3245(10.0, 3.0, 3.0, 1.0)
    diff := res - 45.4500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-3245!")
