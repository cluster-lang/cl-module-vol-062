// cl-phys-rk4-integrator-stage-3920: Test Suite
import "../prk_3920.zk"

fn test_run():
    res := rk4_step_3920(10.0, 3.0, 3.0, 1.0)
    diff := res - 52.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
