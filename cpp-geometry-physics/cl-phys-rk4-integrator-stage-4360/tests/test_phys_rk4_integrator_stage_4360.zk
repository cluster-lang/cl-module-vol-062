import "../prk_4360.zk"

fn test_run():
    res := rk4_step_4360(10.0, 3.0, 3.0, 1.0)
    diff := res - 56.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
