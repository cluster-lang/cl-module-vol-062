// cl-phys-rk4-integrator-stage-3691: Test Suite
import "../prk_3691.zk"

fn test_run():
    res := rk4_step_3691(10.0, 3.0, 3.0, 1.0)
    diff := res - 49.9100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
