// cl-phys-rk4-integrator-stage-4896: Test Suite
import "../prk_4896.zk"

fn test_run():
    res := rk4_step_4896(10.0, 3.0, 3.0, 1.0)
    diff := res - 61.9600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
