import "../prk_5036.zk"

fn test_run():
    res := rk4_step_5036(10.0, 3.0, 3.0, 1.0)
    diff := res - 63.3600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
