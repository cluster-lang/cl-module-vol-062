// cl-phys-rk4-integrator-stage-6560: Test Suite
import "../prk_6560.zk"

fn test_run():
    res := rk4_step_6560(10.0, 3.0, 3.0, 1.0)
    diff := res - 78.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
