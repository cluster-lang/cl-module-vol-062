// cl-phys-rk4-integrator-stage-4384: Test Suite
import "../prk_4384.zk"

fn test_run():
    res := rk4_step_4384(10.0, 3.0, 3.0, 1.0)
    diff := res - 56.8400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-4384!")
