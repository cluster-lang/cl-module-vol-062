// cl-phys-rk4-integrator-stage-7764: Test Suite
import "../prk_7764.zk"

fn test_run():
    res := rk4_step_7764(10.0, 3.0, 3.0, 1.0)
    diff := res - 90.6400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
