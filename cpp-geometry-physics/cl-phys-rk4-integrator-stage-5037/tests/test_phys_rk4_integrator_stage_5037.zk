// cl-phys-rk4-integrator-stage-5037: Test Suite
import "../prk_5037.zk"

fn test_run():
    res := rk4_step_5037(10.0, 3.0, 3.0, 1.0)
    diff := res - 63.3700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
