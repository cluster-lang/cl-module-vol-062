// cl-phys-rk4-integrator-stage-4104: Test Suite
import "../prk_4104.zk"

fn test_run():
    res := rk4_step_4104(10.0, 3.0, 3.0, 1.0)
    diff := res - 54.0400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
