// cl-phys-rk4-integrator-stage-3686: Test Suite
import "../prk_3686.zk"

fn test_run():
    res := rk4_step_3686(10.0, 3.0, 3.0, 1.0)
    diff := res - 49.8600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
