// cl-phys-rk4-integrator-stage-4870: Test Suite
import "../prk_4870.zk"

fn test_run():
    res := rk4_step_4870(10.0, 3.0, 3.0, 1.0)
    diff := res - 61.7000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-4870!")
